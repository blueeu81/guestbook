<% include header %>

<h2>Write a new entry</h2>

<form method="post" role="form">
  <div class="form-group">
    <label for="title">Title</label>
    <input type="text" class="form-control" id="title" name="title" placeholder="Entry title" required>
  </div>
  <div class="form-group">
    <label for="body">식단 내용 입력</label>
    <textarea class="form-control" id="body" name="body" placeholder="원하는 식단을 입력하세요." rows="3" required></textarea>
  </div>
  <div class="form-group">
    <input type="submit" value="식단 등록" class="btn btn-primary">
  </div>
</form>

<% include footer %>
